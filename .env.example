# Model names
GENERATION_MODEL_PROVIDER=ollama
VERIFIER_MODEL_PROVIDER=ollama
REASONER_MODEL_PROVIDER=ollama
RAG_EMBEDDING_MODEL_PROVIDER=ollama
GENERATOR_MODEL=gemma4
VERIFIER_MODEL=gemma4
REASONER_MODEL=gemma4
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_ENDPOINT=http://127.0.0.1:11434

# LlamaIndex storage and indexing
INPUT_BASE_DIR=data/evidence/mimic_discharge_subset
OUTPUT_BASE_DIR=output
# Default runtime mode for entrypoints that read schema mode from env.
# The explicit `python make_index.py build-schema` command overrides this.
INDEX_SCHEMA_GUIDED=false
UMLS_ENABLED=true
MIMIC_DISCHARGE_CSV=data/mimic_iv_note/discharge.csv
MIMIC_DISCHARGE_NOTE_TYPE=DS
# Use an integer cap, or "all" for no cap.
MIMIC_DISCHARGE_LIMIT=25
MIMIC_DISCHARGE_MAX_CHARS=6000
UMLS_HINT_LIMIT=120
# Optional index-specific model overrides
# INDEX_LLM_MODEL=medgemma1.5
# INDEX_LLM_REQUEST_TIMEOUT=180
# INDEX_EMBEDDING_MODEL=embeddinggemma:latest
INDEX_SCHEMA_NUM_WORKERS=1
INDEX_SCHEMA_MAX_TRIPLETS_PER_CHUNK=6

# Smoke/evaluation controls
RANDOM_SEED=42
EVAL_SAMPLE_SIZE=1
MAX_ROUNDS=3

# Clinical concept normalization
UMLS_API_KEY=
UMLS_VERSION=current
UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
UMLS_PAGE_SIZE=10
UMLS_SOURCE_VOCABS=ICD10CM,SNOMEDCT_US,RXNORM,ATC,CPT,HCPCS,LNC,MEDCIN,MSH
