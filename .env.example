# Copy this file to .env in the same folder as the notebook, then fill in the values.
# Never commit .env. Never put licensed data or patient text in it.

# --- Hugging Face ---
# Token with read/write access to the artifacts bucket. Required only to submit a job.
HF_TOKEN=
HF_BUCKET=Dugerij/jobs-artifacts
HF_IMAGE=vllm/vllm-openai:v0.18.1
HF_FLAVOR=a100-large

# --- Where the run lives ---
# ROOT holds everything. Leave blank to use ./reproduction next to the notebook.
ROOT=
# INPUT holds the licensed data. if left blank, defaults to ROOT/input.
INPUT=

# --- Licensed inputs ---
# Point these at your own copies. if left blank, looks for files in INPUT.
# UMLS_META expects MRCONSO.RRF and MRSTY.RRF inside it.
UMLS_META=
DIRECT=

# --- Source ---
REPO_URL=https://github.com/dugerij/argumentation_schemes_for_clinical_decisions.git

# --- Models ---
# Leave everything below blank to use the pinned defaults: MedGemma for the generator,
# verifier and reasoner, and Qwen3-30B-A3B-Instruct for the judge, each pinned to a fixed
# revision. Overriding any of them breaks the frozen determinism contract (notebook
# Section 4) for that run -- note it in the report if you set one.
#
# CHAT_MODEL_ID/CHAT_MODEL_REVISION change all three of generator, verifier and reasoner
# at once. GENERATOR_MODEL_ID, VERIFIER_MODEL_ID and REASONER_MODEL_ID each override just
# that one role and fall back to CHAT_MODEL_ID when left blank, so you can run, say, only
# the reasoner on a different model while generator and verifier stay on the default.
#
# The job starts one server per distinct model actually in use, not one per role, so
# leaving all three blank still starts exactly one chat server. Splitting them costs GPU
# memory: the chat role's total memory share is fixed and divided evenly across however
# many distinct models you configure, so each additional distinct model leaves less memory
# (and less context headroom) for every model in play. Consider a bigger flavor if you use
# more than one.
CHAT_MODEL_ID=
CHAT_MODEL_REVISION=
GENERATOR_MODEL_ID=
GENERATOR_MODEL_REVISION=
VERIFIER_MODEL_ID=
VERIFIER_MODEL_REVISION=
REASONER_MODEL_ID=
REASONER_MODEL_REVISION=
JUDGE_MODEL_ID=
JUDGE_MODEL_REVISION=
