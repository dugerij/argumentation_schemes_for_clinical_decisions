# LLM providers
GENERATION_MODEL_PROVIDER=ollama
VERIFIER_MODEL_PROVIDER=ollama
REASONER_MODEL_PROVIDER=ollama
RAG_EMBEDDING_MODEL_PROVIDER=ollama

# Model names
GENERATOR_MODEL=gpt-oss:120b-cloud
VERIFIER_MODEL=gpt-oss:120b-cloud
REASONER_MODEL=gpt-oss:120b-cloud
RAG_EMBEDDING_MODEL=embeddinggemma:300m

# Provider credentials
# Leave blank for local Ollama. Set the key needed by your chosen provider.
GRAPHRAG_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LlamaIndex storage and indexing
INPUT_BASE_DIR=data/evidence/mimic_discharge_subset
OUTPUT_BASE_DIR=output
INDEX_SCHEMA_GUIDED=true
UMLS_ENABLED=true
MIMIC_DISCHARGE_CSV=data/mimic_iv_note/discharge.csv
MIMIC_DISCHARGE_NOTE_TYPE=DS
# Use an integer cap, or "all" for no cap.
MIMIC_DISCHARGE_LIMIT=25
MIMIC_DISCHARGE_MAX_CHARS=6000
UMLS_HINT_LIMIT=120
# Optional index-specific model overrides
# INDEX_LLM_PROVIDER=ollama
# INDEX_LLM_MODEL=llama3.1
# INDEX_LLM_REQUEST_TIMEOUT=180
# INDEX_EMBEDDING_PROVIDER=ollama
# INDEX_EMBEDDING_MODEL=embeddinggemma:300m
# For vLLM OpenAI-compatible serving:
# INDEX_LLM_PROVIDER=vllm
# INDEX_EMBEDDING_PROVIDER=vllm
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_SCHEMA_NUM_WORKERS=1
INDEX_SCHEMA_MAX_TRIPLETS_PER_CHUNK=6

# Smoke/evaluation controls
RANDOM_SEED=42
EVAL_SAMPLE_SIZE=1
MAX_ROUNDS=3

# Clinical concept normalization
UMLS_API_KEY=
UMLS_VERSION=current
UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
UMLS_PAGE_SIZE=10
UMLS_SOURCE_VOCABS=ICD10CM,SNOMEDCT_US,RXNORM,ATC,CPT,HCPCS,LNC,MEDCIN,MSH
