# LLM providers
GENERATION_MODEL_PROVIDER=ollama
VERIFIER_MODEL_PROVIDER=ollama
REASONER_MODEL_PROVIDER=ollama
RAG_EMBEDDING_MODEL_PROVIDER=ollama

# Model names
GENERATOR_MODEL=gpt-oss:120b-cloud
VERIFIER_MODEL=gpt-oss:120b-cloud
REASONER_MODEL=gpt-oss:120b-cloud
RAG_EMBEDDING_MODEL=embeddinggemma:300m

# Provider credentials
# Leave blank for local Ollama. Set the key needed by your chosen provider.
GRAPHRAG_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GraphRAG storage and indexing
INPUT_BASE_DIR=data/medqa/data_clean/textbooks/en
INPUT_STORAGE_TYPE=file
OUTPUT_BASE_DIR=output
OUTPUT_STORAGE_TYPE=file
GRAPHRAG_INDEX_METHOD=standard
COMPLETION_MODEL_AUTH_TYPE=api_key
EMBEDDING_MODEL_AUTH_TYPE=api_key
ENTITY_TYPES=disease,symptom,clinical_finding,medication,treatment,procedure,lab_test,test_result,anatomy,side_effect,complication,risk_factor

# Smoke/evaluation controls
RANDOM_SEED=42
EVAL_SAMPLE_SIZE=1
MAX_ROUNDS=3

# Clinical concept normalization
UMLS_ENABLED=false
UMLS_API_KEY=
UMLS_VERSION=current
UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
UMLS_PAGE_SIZE=10
UMLS_SOURCE_VOCABS=ICD10CM,SNOMEDCT_US,RXNORM,ATC,CPT,HCPCS,LNC,MEDCIN,MSH
