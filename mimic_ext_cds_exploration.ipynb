    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# MIMIC-IV-Ext CDS Exploration\n",
        "\n",
        "This notebook validates the MIMIC-IV-Ext clinical decision support archive, inspects the task files, and sketches a compact case-graph representation keyed by `stay_id`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from dataclasses import asdict, dataclass\n",
        "import ast\n",
        "import io\n",
        "from pathlib import Path\n",
        "import zipfile\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "pd.set_option(\"display.max_colwidth\", 140)\n",
        "pd.set_option(\"display.max_columns\", 30)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "ZIP_PATH = Path(\"data/mimic-iv-ext-clinical-decision-support-for-referral-triage-and-diagnosis-1.0.2 (1).zip\")\n",
        "ZIP_PATH"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "with zipfile.ZipFile(ZIP_PATH) as archive:\n",
        "    members = archive.namelist()\n",
        "\n",
        "members"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def read_csv_from_outer_zip(zip_path: Path, member_suffix: str) -> pd.DataFrame:\n",
        "    with zipfile.ZipFile(zip_path) as archive:\n",
        "        member_name = next(name for name in archive.namelist() if name.endswith(member_suffix))\n",
        "        with archive.open(member_name) as raw_file:\n",
        "            return pd.read_csv(raw_file)\n",
        "\n",
        "\n",
        "def read_csv_from_nested_zip(zip_path: Path, outer_member_suffix: str, inner_member_suffix: str) -> pd.DataFrame:\n",
        "    with zipfile.ZipFile(zip_path) as archive:\n",
        "        outer_member_name = next(name for name in archive.namelist() if name.endswith(outer_member_suffix))\n",
        "        with archive.open(outer_member_name) as raw_file:\n",
        "            nested_bytes = raw_file.read()\n",
        "\n",
        "    with zipfile.ZipFile(io.BytesIO(nested_bytes)) as nested_archive:\n",
        "        inner_member_name = next(name for name in nested_archive.namelist() if name.endswith(inner_member_suffix))\n",
        "        with nested_archive.open(inner_member_name) as inner_file:\n",
        "            return pd.read_csv(inner_file)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "clinical_data = read_csv_from_nested_zip(ZIP_PATH, \"clinical_data.csv.zip\", \"clinical_data.csv\")\n",
        "diagnosis = read_csv_from_outer_zip(ZIP_PATH, \"diagnosis.csv\")\n",
        "triage_level = read_csv_from_outer_zip(ZIP_PATH, \"triage_level.csv\")\n",
        "specialty_referral = read_csv_from_outer_zip(ZIP_PATH, \"specialty_referral.csv\")\n",
        "initial_assessment = read_csv_from_outer_zip(ZIP_PATH, \"initial_assessment_info.csv\")\n",
        "vital_signs = read_csv_from_outer_zip(ZIP_PATH, \"vital_signs.csv\")\n",
        "patient_demographics = read_csv_from_outer_zip(ZIP_PATH, \"patient_demographics.csv\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "summary = pd.DataFrame(\n",
        "    [\n",
        "        {\"table\": \"clinical_data\", \"rows\": len(clinical_data), \"columns\": list(clinical_data.columns)},\n",
        "        {\"table\": \"diagnosis\", \"rows\": len(diagnosis), \"columns\": list(diagnosis.columns)},\n",
        "        {\"table\": \"triage_level\", \"rows\": len(triage_level), \"columns\": list(triage_level.columns)},\n",
        "        {\"table\": \"specialty_referral\", \"rows\": len(specialty_referral), \"columns\": list(specialty_referral.columns)},\n",
        "        {\"table\": \"initial_assessment\", \"rows\": len(initial_assessment), \"columns\": list(initial_assessment.columns)},\n",
        "        {\"table\": \"vital_signs\", \"rows\": len(vital_signs), \"columns\": list(vital_signs.columns)},\n",
        "        {\"table\": \"patient_demographics\", \"rows\": len(patient_demographics), \"columns\": list(patient_demographics.columns)},\n",
        "    ]\n",
        ")\n",
        "\n",
        "summary"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "clinical_data.head(2)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "diagnosis.head(2)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Case graph sketch\n",
        "\n",
        "The CDS archive is already case-centered. A defensible graph unit is one graph per `stay_id`, with task labels such as diagnosis, triage, or specialty referral attached as gold targets rather than retrieval evidence."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "@dataclass(frozen=True)\n",
        "class CaseNode:\n",
        "    node_id: str\n",
        "    label: str\n",
        "    text: str\n",
        "\n",
        "\n",
        "@dataclass(frozen=True)\n",
        "class CaseEdge:\n",
        "    source_id: str\n",
        "    relation: str\n",
        "    target_id: str\n",
        "\n",
        "\n",
        "@dataclass(frozen=True)\n",
        "class CaseGraph:\n",
        "    stay_id: int\n",
        "    nodes: tuple[CaseNode, ...]\n",
        "    edges: tuple[CaseEdge, ...]\n",
        "    gold_targets: dict[str, object]\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def parse_list_column(value: object) -> list[str]:\n",
        "    if value is None or (isinstance(value, float) and pd.isna(value)):\n",
        "        return []\n",
        "    text = str(value).strip()\n",
        "    if not text:\n",
        "        return []\n",
        "    try:\n",
        "        parsed = ast.literal_eval(text)\n",
        "    except (SyntaxError, ValueError):\n",
        "        return [text]\n",
        "    if isinstance(parsed, list):\n",
        "        return [str(item) for item in parsed]\n",
        "    return [str(parsed)]\n",
        "\n",
        "\n",
        "def build_case_graph(stay_id: int) -> CaseGraph:\n",
        "    diagnosis_row = diagnosis.loc[diagnosis[\"stay_id\"] == stay_id].iloc[0]\n",
        "    assessment_row = initial_assessment.loc[initial_assessment[\"stay_id\"] == stay_id].iloc[0]\n",
        "    vitals_row = vital_signs.loc[vital_signs[\"stay_id\"] == stay_id].iloc[0]\n",
        "\n",
        "    nodes: list[CaseNode] = [\n",
        "        CaseNode(f\"case:{stay_id}\", \"CASE\", f\"stay_id={stay_id}\"),\n",
        "        CaseNode(f\"case:{stay_id}:hpi\", \"HPI\", str(diagnosis_row[\"HPI\"])),\n",
        "        CaseNode(f\"case:{stay_id}:patient\", \"PATIENT_INFO\", str(diagnosis_row[\"patient_info\"])),\n",
        "        CaseNode(f\"case:{stay_id}:vitals\", \"VITALS\", str(diagnosis_row[\"initial_vitals\"])),\n",
        "        CaseNode(f\"case:{stay_id}:chief_complaint\", \"CHIEF_COMPLAINT\", str(assessment_row[\"chiefcomplaint\"])),\n",
        "        CaseNode(f\"case:{stay_id}:assessment\", \"INITIAL_ASSESSMENT\", str(assessment_row.to_dict())),\n",
        "        CaseNode(f\"case:{stay_id}:structured_vitals\", \"STRUCTURED_VITALS\", str(vitals_row.to_dict())),\n",
        "    ]\n",
        "\n",
        "    edges = [\n",
        "        CaseEdge(f\"case:{stay_id}\", \"HAS_HPI\", f\"case:{stay_id}:hpi\"),\n",
        "        CaseEdge(f\"case:{stay_id}\", \"HAS_PATIENT_INFO\", f\"case:{stay_id}:patient\"),\n",
        "        CaseEdge(f\"case:{stay_id}\", \"HAS_INITIAL_VITALS\", f\"case:{stay_id}:vitals\"),\n",
        "        CaseEdge(f\"case:{stay_id}\", \"HAS_CHIEF_COMPLAINT\", f\"case:{stay_id}:chief_complaint\"),\n",
        "        CaseEdge(f\"case:{stay_id}\", \"HAS_INITIAL_ASSESSMENT\", f\"case:{stay_id}:assessment\"),\n",
        "        CaseEdge(f\"case:{stay_id}\", \"HAS_STRUCTURED_VITALS\", f\"case:{stay_id}:structured_vitals\"),\n",
        "    ]\n",
        "\n",
        "    primary_diagnoses = parse_list_column(diagnosis_row[\"primary_diagnosis\"])\n",
        "    secondary_diagnoses = parse_list_column(diagnosis_row[\"secondary_diagnosis\"])\n",
        "    for index, text in enumerate(primary_diagnoses, start=1):\n",
        "        node_id = f\"case:{stay_id}:primary_diagnosis:{index}\"\n",
        "        nodes.append(CaseNode(node_id, \"DIAGNOSIS\", text))\n",
        "        edges.append(CaseEdge(f\"case:{stay_id}\", \"HAS_PRIMARY_DIAGNOSIS\", node_id))\n",
        "\n",
        "    for index, text in enumerate(secondary_diagnoses, start=1):\n",
        "        node_id = f\"case:{stay_id}:secondary_diagnosis:{index}\"\n",
        "        nodes.append(CaseNode(node_id, \"DIAGNOSIS\", text))\n",
        "        edges.append(CaseEdge(f\"case:{stay_id}\", \"HAS_SECONDARY_DIAGNOSIS\", node_id))\n",
        "\n",
        "    gold_targets = {\n",
        "        \"triage\": triage_level.loc[triage_level[\"stay_id\"] == stay_id, \"triage\"].iloc[0] if stay_id in set(triage_level[\"stay_id\"]) else None,\n",
        "        \"specialty_referral\": parse_list_column(specialty_referral.loc[specialty_referral[\"stay_id\"] == stay_id, \"specialty\"].iloc[0]) if stay_id in set(specialty_referral[\"stay_id\"]) else [],\n",
        "        \"primary_diagnosis\": primary_diagnoses,\n",
        "        \"secondary_diagnosis\": secondary_diagnoses,\n",
        "    }\n",
        "    return CaseGraph(stay_id=stay_id, nodes=tuple(nodes), edges=tuple(edges), gold_targets=gold_targets)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "sample_stay_id = int(diagnosis.iloc[0][\"stay_id\"])\n",
        "sample_graph = build_case_graph(sample_stay_id)\n",
        "len(sample_graph.nodes), len(sample_graph.edges), sample_graph.gold_targets"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "pd.DataFrame([asdict(node) for node in sample_graph.nodes]).head(12)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "pd.DataFrame([asdict(edge) for edge in sample_graph.edges])"
      ]
    },
